# ============================================================================
# 构建上下文排除清单
#
# 作用有两个，第二个更重要：
#   1. 减小构建上下文体积（node_modules / .venv 可能有几百 MB）
#   2. **防止密钥与用户数据被烘进镜像** —— 镜像层一旦构建就无法撤销，
#      任何拿到镜像的人都能读出里面的 .env
# ============================================================================

# ---- 密钥（最高优先级）----
.env
.env.*
!.env.example
**/.env
**/.env.*

# ---- 依赖与虚拟环境 ----
backend/.venv/
**/node_modules/
**/__pycache__/
**/*.py[cod]
.uv-cache/

# ---- 数据库（含访客真实数据）----
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite3

# ---- 版本控制与工具产物 ----
.git/
.gitignore
.github/
**/.DS_Store
**/.eslintcache

# ---- 构建产物（前端产物在镜像内重新构建）----
frontend/dist/
frontend/dist-ssr/

# ---- 文档与截图（不影响运行）----
docs/
*.md
!README.md
