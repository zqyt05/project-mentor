# 静态检查配置
#
# 只启用 flake8 的 F 类检查（即 pyflakes 的语义检查），关闭 E/W 风格检查 ——
# 本项目的代码风格由 CI 的其它环节与人工评审把关，这里聚焦真正会出错的语义问题。
#
# 最看重 F821「undefined name」：函数体引用了签名里没声明的变量
#（例如忘记加 db / visitor 依赖）。这类缺陷只在对应接口被真正调用时
# 才暴露为 500，单测若不覆盖该路径就发现不了 —— 本项目已因此踩过两次。
#
# 使用 `# noqa: F401` 标注刻意的导入副作用（如导入 models 以注册 SQLAlchemy 模型）。
[flake8]
select = F
exclude = .venv,__pycache__,.uv-cache
