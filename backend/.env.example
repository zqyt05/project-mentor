# ============================================================================
# ProjectMentor 配置示例
#
# 复制成 .env 后填入真实值：
#   cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，绝不要提交到仓库。
# ============================================================================

# ===== DeepSeek =====
# 申请地址：https://platform.deepseek.com/
# 注意：DeepSeek 不提供消费上限，建议「只充值小额」，
#       或使用下面的 DAILY_LLM_CALL_LIMIT 在应用层兜底。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== GitHub =====
# 可选。不填也能用，但速率限制较低（60 次/小时 vs 5000 次/小时）
GITHUB_TOKEN=

# ===== 演示模式（分享给他人试用时才需要）=====
# 访问口令。留空 = 门禁关闭，行为与本地单用户模式完全一致。
# 填入任意口令即开启：访客需先输口令，且各自的项目互相隔离。
# 该值同时用作访客 Cookie 的签名密钥，更换会让已登录的访客重新验证。
DEMO_PASSWORD=

# 每日 AI 调用上限（保护你的钱包）。
# 0 = 不限制（本地默认）。分享给朋友时建议设为 50-100。
# 按「实际 LLM 调用次数」统计：
#   项目匹配 2-3 次 / 任务拆解 1 次 / 答疑 1 次 / 复盘 1-2 次
# 因此一次完整体验大约消耗 6-8 次。
DAILY_LLM_CALL_LIMIT=0

# ===== 数据库 =====
# 留空即使用默认值：backend/projectmentor.db（绝对路径，与启动目录无关）
# DATABASE_URL=

# ===== CORS =====
# 仅在使用 Vite 开发服务器（前后端分离调试）时需要。
# 演示模式由后端托管前端，同源部署无需配置。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
