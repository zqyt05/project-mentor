# --- 环境变量 / 敏感信息 ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.db
*.sqlite3
# SQLite WAL 模式的附属文件 —— 它们**包含真实数据**，
# 而 `*.db` 通配不会匹配 `xxx.db-wal`，必须单独列出
*.db-wal
*.db-shm
*.db-journal
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / 前端 ---
node_modules/
dist/
dist-ssr/
*.local
.vite/
*.tsbuildinfo

# --- 本机构建工具缓存（uv / pnpm / npm）---
# 为避免写入用户主目录，本地开发时会把缓存重定向到仓库内，故在此忽略
.uv-cache/
.uv-python/
.pnpm-store/
.pnpm-home/
.npm-cache/

# --- IDE / 系统 ---
.vscode/
.idea/
.DS_Store
*.log
