# ============================================================
# ProjectMentor 环境变量示例
# 使用方法：复制为 backend/.env 并填入真实值
#   cp .env.example backend/.env
# 注意：backend/.env 已被 .gitignore 忽略，请勿提交真实密钥
# ============================================================

# ===== DeepSeek API（必填）=====
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 推理模型，思考过程也消耗 token，长文生成需要较大预算
DEEPSEEK_MODEL=deepseek-flash

# ===== GitHub API（可选，建议填写）=====
# 申请地址：https://github.com/settings/tokens （只需 public_repo 读权限）
# 未配置时搜索接口速率限制为 10 次/分钟，配置后为 30 次/分钟
GITHUB_TOKEN=your_github_token_here

# ===== 数据库（可选，默认即可）=====
# 默认值：<backend 目录>/projectmentor.db 的绝对路径，
#   不写这一项时，无论从哪个目录启动后端，数据库都落在 backend/ 下同一位置。
# SQLite 绝对路径需要四个斜杠（sqlite:////绝对路径）
# DATABASE_URL=sqlite:////data/projectmentor.db

# ===== LLM 调优（可选，留空使用默认值）=====
# deepseek-flash 为推理模型，正文前会输出思考内容，max_tokens 过小会导致回答为空
# LLM_MAX_TOKENS=8192
# LLM_TEMPERATURE=0.4
# LLM_TIMEOUT=180

# ===== GitHub 检索筛选条件（可选）=====
# 优质项目不足 GITHUB_MIN_QUALIFIED 个时，自动降级到 AI 定制项目路径
# GITHUB_MIN_STARS=500
# GITHUB_CANDIDATE_LIMIT=10
# GITHUB_MIN_QUALIFIED=3

# ===== 服务与跨域（可选）=====
# HOST=127.0.0.1
# PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
